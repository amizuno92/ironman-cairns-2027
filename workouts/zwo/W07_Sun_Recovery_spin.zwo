<workout_file>
    <author>Andrew Mizuno</author>
    <name>W7 Sun - Recovery spin</name>
    <description>IM Cairns plan week 7. Easy spin, high cadence. Power under 55% FTP. Target: Z1 &lt;142W (&lt;55%) · HR &lt;130 · RPE 1–2. Easy spin, 25' at high cadence (90–100 rpm). Replaces a 4th swim — keeps the legs moving after Saturday's long ride.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.400" PowerHigh="0.500" pace="0"/>
        <SteadyState Duration="1140" Power="0.500" pace="0" Cadence="95"/>
        <Cooldown Duration="180" PowerLow="0.500" PowerHigh="0.400" pace="0"/>
    </workout>
</workout_file>
