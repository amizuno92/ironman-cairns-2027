<workout_file>
    <author>Andrew Mizuno</author>
    <name>W6 Thu - Recovery spin</name>
    <description>IM Cairns plan week 6. Easy spin, high cadence. Power under 55% FTP. Target: Z1 &lt;133W (&lt;55%) · HR &lt;130 · RPE 1–2. Easy spin, 40' at high cadence (90–100 rpm). </description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="180" PowerLow="0.400" PowerHigh="0.500" pace="0"/>
        <SteadyState Duration="2040" Power="0.500" pace="0" Cadence="95"/>
        <Cooldown Duration="180" PowerLow="0.500" PowerHigh="0.400" pace="0"/>
    </workout>
</workout_file>
